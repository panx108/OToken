# File path: /etc/systemd/system/otoken.service
# sudo systemctl daemon-reload
# sudo systemctl start otoken
# sudo systemctl enable otoken
# sudo systemctl status otoken
[Unit]
Description=One API Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/new-api  # 注意修改路径
ExecStart=/path/to/new-api/new-api --port 3000 --log-dir /path/to/new-api/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
